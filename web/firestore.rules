rules_version = '2';

// Qualquer usuário logado lê e edita as pautas de todas as áreas.
// Só administradores finalizam a daily; só o usuário mestre gerencia usuários.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMaster() {
      return signedIn() && request.auth.token.email == 'elias.almeida@graodireto.com.br';
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/rh-daily-users/$(request.auth.token.email)).data.admin == true;
    }

    match /rh-daily/_meta {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /rh-daily/_presence {
      allow read, write: if signedIn();
    }
    // Áreas (dp, bp, rs, est). Exclui os documentos especiais acima.
    match /rh-daily/{area} {
      allow read: if signedIn();
      allow write: if signedIn() && area != '_meta';
    }
    match /rh-daily/{area}/history/{entry} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /rh-daily-users/{email} {
      allow read: if signedIn();
      allow write: if isMaster();
    }
  }
}
